# Application Settings
PROJECT_NAME="STQMS - Standard & Quality Management System"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api"

# Security & Authentication
SECRET_KEY="your-super-secret-key-change-it-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_strong_password"
POSTGRES_DB="stqms_db"
DATABASE_URL="postgresql+asyncpg://postgres:your_strong_password@localhost:5432/stqms_db"

# Storage & Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]